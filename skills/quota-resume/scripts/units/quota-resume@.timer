[Unit]
# 模板单元：quota-resume@<task>.timer
# 短周期轻量唤醒：控制器自行读取状态里的 nextCheckAt，
# 未到时间立即退出，不查询额度、不调用模型。
Description=Quota-resume lightweight wakeup for task %i
Documentation=file:%h/.local/share/agent-task-resume/quota-resume/references/controller-usage.md

[Timer]
OnBootSec=2min
OnUnitInactiveSec=1min
Persistent=true
AccuracySec=30s
Unit=quota-resume@%i.service

[Install]
WantedBy=timers.target
