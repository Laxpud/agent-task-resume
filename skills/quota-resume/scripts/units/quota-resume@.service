[Unit]
# 模板单元：quota-resume@<task>.service
# <task> 对应 ~/.config/quota-resume/tasks/<task>.json
# 安装步骤见 references/controller-usage.md；先将技能复制到
# ~/.local/share/agent-task-resume/quota-resume，再安装本单元。
Description=Quota-resume controller cycle for task %i
Documentation=file:%h/.local/share/agent-task-resume/quota-resume/references/controller-usage.md

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Asia/Shanghai

# 额度查询会访问 chatgpt.com 后端。systemd 不继承交互式 shell 的代理变量，
# 缺少代理会让额度查询以 -32603 失败（"error sending request for url .../wham/usage"）。
# 代理等环境相关取值放在用户私有文件，不写进可分发单元；文件缺失也不报错。
EnvironmentFile=-%h/.config/quota-resume/proxy.env

# 使用固定安装目录中的控制器；%i 选择对应的私有任务配置。
ExecStart=/usr/bin/python3 %h/.local/share/agent-task-resume/quota-resume/scripts/quota_resume.py --cycle --config %h/.config/quota-resume/tasks/%i.json

# 单次运行必须有超时；长任务靠持久回执跟踪，不让 service 无限等待。
TimeoutStartSec=600

# 控制器自身用文件锁串行化，这里不叠加 systemd 级重试，避免两层退避。
Restart=no

# 加固说明：控制器必须能写 ~/.codex（app-server 队列状态）与
# ~/.local/state/quota-resume（回执与日志），目标工作树也可能位于
# ~/.codex/worktrees/ 之下，因此不启用 ProtectHome=read-only 或
# PrivateTmp —— 它们会直接挡住续跑本身。工作范围限制交由 codex 自身的
# 沙箱策略（workspace-write）负责，而不是由外层单元代劳。
NoNewPrivileges=yes

[Install]
WantedBy=default.target
